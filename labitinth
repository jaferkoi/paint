from turtle import *
from random import randint

s_width = 200
s_height = 180
wall_positions=[]
class Sprite(Turtle):
    def __init__(self, x, y, color, shape):
        super().__init__()
        self.up()
        self.goto(x, y)
        self.color(color)
        self.shape(shape)
        self.speed(10)
        self.step = 10
    
    def move_right(self):
        self.setheading(0)
        if player.is_collide_wall(player.xcor()+(self.step+5),player.ycor()):
            player.goto(-150,0)
        else:
            self.goto(self.xcor() + self.step, self.ycor())
        
    def move_left(self):
        self.setheading(180)
        if player.is_collide_wall(player.xcor()-(self.step+5),player.ycor()):
            player.goto(-150,0)
        else:
            self.goto(self.xcor() - self.step, self.ycor())
        
    def move_up(self):
        self.setheading(90)
        if player.is_collide_wall(player.xcor(),player.ycor()+(self.step+5)):
            player.goto(-150,0)
        else:
            self.goto(self.xcor(), self.ycor() + self.step)
        
    def move_down(self):
        self.setheading(270)
        if player.is_collide_wall(player.xcor(),player.ycor()-(self.step+5)):
            player.goto(-150,0)
        else:
            self.goto(self.xcor(), self.ycor() - self.step)
        
    def is_collide(self, sprite):
        dist = self.distance(sprite.xcor(), sprite.ycor())
        return dist < 20
    def is_collide_wall(self, x, y):
        for wx, wy in wall_positions:
            if abs(x - wx) < 10 and abs(y - wy) < 10:
                return True
        return False

class wall_maker(Sprite):
    def __init__(self, x, y, color='white', shape='square'):
        super().__init__(x,y,color,shape)
        self.speed(30)
    def make_wall(self,n):
        for _ in range(n):
            self.fd(5)
            self.stamp()
            wall_positions.append([self.xcor(),self.ycor()])
        
class Enemy(Sprite):
    def __init__(self, x, y, color, shape):
        Sprite.__init__(self, x, y, color, shape)
        self.step = 20
    
    def move(self, x_start, y_start, x_end, y_end):
        self.x_st = x_start
        self.y_st = y_start
        self.x_en = x_end
        self.y_en = y_end
        self.goto(x_start, y_start)
        self.setheading(self.towards(x_end, y_end))
    
    def make_step(self):
        self.fd(self.step)
        if self.distance(self.x_en, self.y_en) < self.step:
            self.move(self.x_en, self.y_en, self.x_st, self.y_st)


player = Sprite(-150,0, 'orchid', 'turtle')
